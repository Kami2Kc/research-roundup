# Copy to .env and fill in. .env is git-ignored; in CI these come from repository secrets.

# LLM provider: "anthropic", or "fake" for free offline runs with placeholder output
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Cheap, fast model for weekly screening; stronger model for the monthly editor
LLM_SCREEN_MODEL=claude-haiku-5-5
LLM_EDITOR_MODEL=claude-sonnet-5-5

# Sent in the User-Agent header and as Crossref's mailto parameter
CONTACT_EMAIL=

# Optional. Cost guard: maximum papers screened by the LLM per run (default 300)
# SCREEN_LIMIT=300
# Optional. Minimum relevance score (0-10) for the monthly candidate pool (default 6)
# RELEVANCE_THRESHOLD=6
# Optional. The deployed dashboard, for "view online" links in the newsletter
# SITE_URL=https://your-project.vercel.app
